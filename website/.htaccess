# Generated by site/builder (pitty-site). Edit the builder, not this file.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Honor the visitor protocol Cloudflare forwards, so redirects never loop.
RewriteCond %{HTTP:X-Forwarded-Proto} ^http$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://pitty.tech%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://pitty.tech%{REQUEST_URI} [R=301,L,NE]
# The original reference page now lives on the download page and in the guide.
RewriteRule ^install\.html$ /download/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "frame-ancestors 'none'"
Header always set Strict-Transport-Security "max-age=31536000"
# Pages revalidate so releases and instructions appear immediately.
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain application/javascript application/wasm application/xml image/svg+xml
</IfModule>

AddType application/wasm .wasm
AddType font/woff2 .woff2
AddType text/javascript .js
AddCharset utf-8 .html .css .js .svg .txt .xml
<FilesMatch "\.sha256$">
ForceType "text/plain; charset=utf-8"
</FilesMatch>
